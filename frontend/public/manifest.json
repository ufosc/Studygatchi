{
    "manifest_version": 3,
    "name": "Studygatchi",
    "version": "1.0.0",
    "description": "Virtual pet & study assistant",
    "action": {
      "default_popup": "index.html"
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
     "permissions": ["sidePanel", "tabs", "storage", "notifications"],
    "content_scripts": [
      {
        "matches": [
          "*://*.facebook.com/*",
          "*://*.instagram.com/*",
          "*://*.reddit.com/*",
          "*://*.tiktok.com/*",
          "*://*.twitch.tv/*",
          "*://*.x.com/*",
          "*://*.youtube.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "side_panel": {
      "default_path": "index.html"
    }
  }